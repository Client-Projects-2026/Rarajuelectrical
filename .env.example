VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Configure server-only values in Vercel Environment Variables, never as VITE_ variables.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SECRET_KEY=your-server-only-supabase-secret-key
SITE_ORIGIN=https://your-production-domain.example
RATE_LIMIT_SECRET=generate-a-random-secret-of-at-least-32-characters


